# 复制为 deploy/env/.env.test；严禁复用正式环境密码、JWT 或 AI Key。
APP_VERSION=test-local
POSTGRES_USER=paopao_test
POSTGRES_PASSWORD=replace-with-a-different-32-plus-character-password
POSTGRES_DB=paopao_test
DATABASE_URL=postgresql://paopao_test:replace-with-a-different-32-plus-character-password@db:5432/paopao_test
JWT_SECRET=replace-with-a-different-64-hex-character-secret

AI_PROVIDER=glm
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.7-flash
GLM_STOCK_RESEARCH_MODEL=glm-4.1v-thinking-flashx
MX_APIKEY=
ZHIHU_ACCESS_SECRET=
RESEARCH_WAIT_TIMEOUT_MS=300000
