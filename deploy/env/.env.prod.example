# 复制为 deploy/env/.env.prod；该文件不得提交 Git。
APP_VERSION=prod-local
POSTGRES_USER=paopao_prod
POSTGRES_PASSWORD=replace-with-a-unique-32-plus-character-password
POSTGRES_DB=paopao_prod
DATABASE_URL=postgresql://paopao_prod:replace-with-a-unique-32-plus-character-password@db:5432/paopao_prod
JWT_SECRET=replace-with-a-separate-64-hex-character-secret
# 管理员白名单：命中手机号注册/登录时自动提权为 admin（只升不降）；逗号分隔可配多个
ADMIN_PHONES=

AI_PROVIDER=glm
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 注意：glm-4.7-flash 实测长期拥挤（1305/1302 限流），生产建议 glm-4.5-air
GLM_MODEL=glm-4.5-air
GLM_STOCK_RESEARCH_MODEL=glm-4.1v-thinking-flashx
MX_APIKEY=
ZHIHU_ACCESS_SECRET=
RESEARCH_WAIT_TIMEOUT_MS=300000
