# ---- 服务运行 ----
PORT=8080
NODE_ENV=development
# 单实例 API 限流：多实例请改用网关 / Redis 等共享限流。
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=180
# 外部只读请求默认最多重试一次；写操作不会自动重试。
UPSTREAM_RETRY_ATTEMPTS=2

# ---- 可分享 HTML 报告（可选）----
# 部署时填写公网根地址，使 MCP 返回可直接分享的完整链接；本地留空也能返回 localhost 链接。
# PUBLIC_BASE_URL="https://your-domain.example"
# 报告默认保存 7 天。容器部署请将此目录挂载到持久卷，避免重启后链接失效。
# REPORT_OUTPUT_DIR="/app/work/.runtime/reports"
# REPORT_TTL_MS=604800000

# DEEPSEEK_API_KEY: Required for DeepSeek AI API calls.
# Get your key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="your-deepseek-api-key-here"

# AI_BASE_URL: DeepSeek API endpoint (defaults to https://api.deepseek.com)
AI_BASE_URL="https://api.deepseek.com"

# AI_MODEL: Model name (defaults to deepseek-v4-flash)
AI_MODEL="deepseek-v4-flash"

# ---- 知乎开发者 API（可选，服务端专用）----
# 在知乎开发者平台申请后填写。不要提交真实 Secret，也不要放进前端变量。
ZHIHU_ACCESS_SECRET=""

# ---- 东方财富妙想金融资讯搜索（可选，服务端专用）----
# 在妙想开放平台申请后填写。不要提交真实 Key，也不要放进 VITE_* 前端变量。
MX_APIKEY=""

# AKSHARE_PYTHON: Optional override. By default the server uses .venv in the project root.
# Windows: AKSHARE_PYTHON="C:\\path\\to\\project\\.venv\\Scripts\\python.exe"
# Linux/macOS: AKSHARE_PYTHON="/path/to/project/.venv/bin/python"

# ---- AI Provider（智谱 GLM / DeepSeek）----
# GLM 官方 Chat Completions 地址：/api/paas/v4/chat/completions。
# 填入 GLM_API_KEY 后，将 AI_PROVIDER 设为 glm；不要将真实 Key 提交到 Git。
AI_PROVIDER=glm
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 建议在生产环境选择已在账户中可用、稳定的模型；模型可用性由供应商账户和区域决定。
GLM_MODEL=glm-4.5-air
# 个股分析 Agent 单独使用文本模型；无需额外 Key。服务端以结构化 JSON 提示词调用，
# 格式异常会由 GLM_MODEL 的 JSON mode 进行一次独立修复。
GLM_STOCK_RESEARCH_MODEL=glm-4.5-air

# ---- 数据库（方案2：本地 Docker PG / 生产阿里云 PG）----
# 本地 / 同机 ECS 自建 PostgreSQL：先设置 POSTGRES_PASSWORD，再执行 docker compose up -d。
# 数据库端口仅绑定到 127.0.0.1；应用和数据库在同一台机器时使用此连接串。
POSTGRES_USER="gupiao"
POSTGRES_PASSWORD="请替换为至少 32 位随机密码"
POSTGRES_DB="gupiao"
POSTGRES_PORT="5432"
DATABASE_URL="postgres://gupiao:<POSTGRES_PASSWORD>@127.0.0.1:5432/gupiao"
# 生产（阿里云 RDS for PostgreSQL / ECS 自建 PG）示例：
# DATABASE_URL="postgres://user:password@host:5432/gupiao"

# 连接池参数（可选）
# DB_POOL_SIZE=10
# DB_CONNECT_TIMEOUT_MS=5000

# 整份个股研究任务的最长等待时间（默认 600000，即 10 分钟）。
# 单个数据源、单次 AI 调用各有独立预算；慢模块不会阻塞已完成的确定性快照展示。
# RESEARCH_WAIT_TIMEOUT_MS=600000
# RESEARCH_SOURCE_TIMEOUT_MS=45000
# AI_REQUEST_TIMEOUT_MS=90000

# 中国 A 股休市日：默认内置上交所 2026 年安排。跨年度部署时，可用逗号分隔的 YYYY-MM-DD 日期覆盖。
# CN_MARKET_HOLIDAYS="2027-01-01,2027-02-06,2027-02-07"

# ---- 认证（手机号 + 密码）----
# 生产环境务必改成足够长的随机串！可用：openssl rand -hex 32
JWT_SECRET="dev-only-insecure-secret-change-me"
# Access Token 过期秒数（默认 7 天）
# JWT_EXPIRES_IN_SECONDS=604800
# 管理员白名单：命中手机号注册/登录时自动提权为 admin（只升不降）；逗号分隔可配多个。
# 管理端能力：访问统计（UV/PV/DAU/来源/平台/设备）、用户列表、封禁/解封。
ADMIN_PHONES=""
