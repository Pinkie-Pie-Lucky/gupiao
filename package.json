{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test:technical-market": "node --test scripts/technical-market-agent.test.mjs",
    "test:event-rules": "tsx --test scripts/event-rules.test.ts",
    "test:event-agent": "tsx --test scripts/event-agent.test.ts",
    "test:stock-sentiment": "tsx --test scripts/stock-sentiment.test.ts",
    "test:sentiment-agent": "tsx --test scripts/sentiment-agent.test.ts",
    "test:stock-valuation": "tsx --test scripts/stock-valuation.test.ts",
    "test:valuation-agent": "tsx --test scripts/valuation-agent.test.ts",
    "test:stock-manager": "tsx --test scripts/stock-manager.test.ts",
    "test:cio-manager-agent": "tsx --test scripts/cio-manager-agent.test.ts",
    "test:cio-manager-scenarios": "tsx --test scripts/cio-manager-scenarios.test.ts",
    "test:risk-snapshot": "tsx --test scripts/risk-snapshot.test.ts",
    "test:risk-counter-agent": "tsx --test scripts/risk-counter-agent.test.ts",
    "test:stock-research-frontend": "tsx --test scripts/stock-research-frontend.test.ts",
    "test:manager-stance": "tsx --test scripts/manager-stance.test.ts",
    "release:check": "node scripts/release-readiness.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^6.47.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
