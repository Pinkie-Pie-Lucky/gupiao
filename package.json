    "test:risk-snapshot": "tsx --test tests/risk-snapshot.test.ts",
    "test:risk-counter-agent": "tsx --test tests/risk-counter-agent.test.ts",
    "test:stock-research-frontend": "tsx --test tests/stock-research-frontend.test.ts",
    "test:manager-stance": "tsx --test tests/manager-stance.test.ts",
    "test:auth": "tsx --test tests/auth-service.test.ts",
    "test:mcp-skills": "tsx --test tests/mcp-skill-contracts.test.ts",
    "test:mcp-stock-tools": "tsx --test tests/mcp-stock-tools.test.ts",
    "test:open-source-runtime": "tsx --test tests/open-source-runtime.test.ts",
    "test:ci": "npm run test:auth && npm run test:technical-market && npm run test:industry-chain-agent && npm run test:event-rules && npm run test:event-agent && npm run test:stock-sentiment && npm run test:sentiment-agent && npm run test:public-hotlists && npm run test:mx-search && npm run test:mx-screener && npm run test:zhihu && npm run test:stock-valuation && npm run test:valuation-agent && npm run test:stock-manager && npm run test:cio-manager-agent && npm run test:cio-manager-scenarios && npm run test:risk-snapshot && npm run test:risk-counter-agent && npm run test:stock-research-frontend && npm run test:manager-stance && npm run test:mcp-skills && npm run test:mcp-stock-tools && npm run test:open-source-runtime",
    "db:migrate": "tsx backend/db/migrate.ts",
    "release:check": "node dev-tools/release-readiness.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
