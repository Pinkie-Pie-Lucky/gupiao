    "test:event-rules": "tsx --test tests/event-rules.test.ts",
    "test:event-agent": "tsx --test tests/event-agent.test.ts",
    "test:stock-sentiment": "tsx --test tests/stock-sentiment.test.ts",
    "test:sentiment-agent": "tsx --test tests/sentiment-agent.test.ts",
    "test:public-hotlists": "tsx --test tests/public-hotlists.test.ts",
    "test:mx-search": "tsx --test tests/mx-search-client.test.ts",
    "test:mx-screener": "tsx --test tests/mx-screener-client.test.ts",
    "test:zhihu": "tsx --test tests/zhihu-client.test.ts",
    "test:stock-valuation": "tsx --test tests/stock-valuation.test.ts",
    "test:valuation-agent": "tsx --test tests/valuation-agent.test.ts",
