    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^6.47.0",
    "pg": "^8.13.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "three": "^0.185.1",
    "vite": "^6.2.3"
  },
